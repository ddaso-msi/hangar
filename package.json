{
  "name": "hangar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions && vite build",
    "preview": "vite preview",
    "dev:cf": "wrangler pages dev dist --port 8788 --persist-to .wrangler/state",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "assets:glb": "node scripts/optimize-glb.mjs",
    "assets:seq": "node scripts/build-sequence.mjs",
    "assets:posters": "node scripts/make-posters.mjs",
    "assets:all": "npm run assets:glb && npm run assets:seq && npm run assets:posters",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p functions"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  }
}
